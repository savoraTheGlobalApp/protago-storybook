PORT=5000

# Existing Supabase project (waitlist + contact form)
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# Storybook Supabase project (orders + photo storage)
# Use the service_role key (Settings → API → service_role), NOT the anon key
SUPABASE_URL_STORY=your_storybook_supabase_url
SUPABASE_SERVICE_KEY_STORY=your_storybook_service_role_key

RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
STORYBOOK_PRICE=499

# MSG91 — OTP verification (https://msg91.com)
# If missing or set to your_msg91_auth_key, server runs in dev/mock mode (OTP = 123456)
MSG91_AUTH_KEY=your_msg91_auth_key
# Create an OTP template in MSG91 dashboard and paste the template ID here
MSG91_TEMPLATE_ID=your_msg91_template_id

# Secret used to sign OTP verification tokens — set a long random string in production
# Works across restarts and multiple Railway replicas (stateless HMAC)
OTP_SIGNING_SECRET=your_otp_signing_secret
